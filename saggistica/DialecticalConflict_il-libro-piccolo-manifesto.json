      "@type": "pp:Conflict",
      "conflict_type": "material_ontological",
      "label": "libro_vs_contenuto",
      "label_en": "book_vs_content",
      "pole_a": {
        "it": "Il libro come corpo materiale: carta, inchiostro, calore, peso."
      },
      "pole_b": {
        "it": "Il contenuto puro, trasferibile su qualsiasi supporto senza la materia."
      },
      "tension_score": 1.0,
      "resolution_status": {
        "status": "unresolved",
        "description": "È la tensione fondativa del manifesto: la materia e il contenuto non sono equivalenti e il libro non li riconcilia.",
        "source_property": "cross_layer_effects/0"
      },
      "non_integrable_residue": {
        "status": true,
        "description": "Il manifesto non stabilisce che il contenuto basti: dichiara la materia come valore autonomo, non come veicolo sostituibile."
