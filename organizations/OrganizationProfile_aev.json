  "organization": {
    "name": "Associazione Editori Veneti",
    "official_name": "Editori Veneti. Associazione delle piccole e medie imprese editoriali del Veneto",
    "acronym": "AEV",
    "url": "https://www.editori-veneti.it/",
    "email": "segreteria@editori-veneti.it",
    "type": "associazione di categoria dell'editoria indipendente del Veneto",
    "nature": "libera associazione volontaria senza finalità di lucro, ai sensi degli artt. 14 e seguenti del codice civile",
    "members_count": 63,
    "legal_seat": "Mestre (Venezia), Via Asseggiano 43B",
    "jurisdiction": "Foro di Venezia",
    "fiscal_year": "1 gennaio – 31 dicembre",
    "duration": "illimitata"
  },
  "statute": {
    "scope_primary": "Aggregare gli editori veneti indipendenti per costituire un qualificato punto di riferimento per l'editoria veneta in ambito regionale, nazionale e internazionale, e rappresentarne gli interessi nei rapporti con enti e istituzioni pubbliche e private.",
    "scope_detail": "Rappresentare, assistere e tutelare gli interessi morali e materiali degli associati. Promuovere la conoscenza e la diffusione del prodotto editoriale e della cultura veneta e italiana. Favorire lo studio dei problemi che riguardano lo sviluppo dell'editoria in Veneto.",
    "member_profile": "Si definisce editore l'impresa, individuale o associata, con un progetto editoriale e un catalogo strutturato, che pubblica per proprio conto e a proprie spese opere di ingegno. Sono escluse le tipografie, il print on demand e la produzione di libri pagati dagli autori.",
    "member_requirements": [
      "sede legale o unità operativa in Veneto",
      "iscrizione alle Camere di Commercio del Veneto per attività editoriale",
      "codice Ateco Editore (58.1) o registrazione come produttrice di libri",
      "progetto editoriale e/o catalogo strutturato",
      "essere un micro, piccolo o medio editore"
    ],
    "member_categories": [
      "Soci Ordinari",
      "Soci Sostenitori",
      "Soci Onorari"
    ],
    "organs": [
      "Assemblea degli associati",
      "Consiglio Direttivo",
      "Presidente",
      "Vicepresidente",
      "Tesoriere",
      "Revisore dei conti (se nominato)",
      "Collegio dei Probiviri (se nominato)"
    ],
    "board_rules": "Il Consiglio Direttivo ha da 7 a 11 membri eletti dall'Assemblea, dura in carica due anni, con un massimo di due mandati consecutivi.",
    "activities_relevant": [
      "organizzare la partecipazione, associata o singola, delle case editrici a mostre e fiere nazionali ed estere (art. 4 lett. g)",
      "promuovere fiere, festival, mostre, conferenze, premi letterari e cicli di presentazioni (art. 4 lett. c)",
      "attivare sostegni finanziari pubblici e privati e partecipare a bandi regionali, nazionali ed europei (art. 4 lett. l)"
    ]
  },
